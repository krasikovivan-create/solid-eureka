# Copy this file to .env and fill in the token.
# Token: Telegram → @BotFather → /newbot
BOT_TOKEN=123456789:AAAA-your-token-here

# Time zone for reminders (each user can change their own with /tz)
BOT_TZ=Europe/Moscow

# Your Telegram id (ask @userinfobot) — unlocks /stats
ADMIN_IDS=

# Only for a server with a public https address; leave empty to use long polling
WEBHOOK_URL=

# Optional: keep data in Upstash Redis (needed on Render's free plan, which has no disk)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
