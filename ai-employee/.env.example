# ─────────────────────────────────────────────────────────────────────────────
# Виртуальный сотрудник — переменные окружения.
# На Railway: сервис → вкладка Variables → New Variable (имя и значение).
# Локально: скопируйте файл в .env и заполните.
# ─────────────────────────────────────────────────────────────────────────────

# [ОБЯЗАТЕЛЬНО] Токен бота от @BotFather (вида 1234567890:AAE...).
TELEGRAM_BOT_TOKEN=

# [ОБЯЗАТЕЛЬНО] Ключ Claude API из console.anthropic.com → API Keys (вида sk-ant-...).
ANTHROPIC_API_KEY=

# Кто может пользоваться ботом: Telegram ID через запятую (узнать — у @userinfobot).
# Пусто — владельцем станет первый, кто нажмёт /start, и только он получит доступ.
ALLOWED_USER_IDS=

# Где хранить базу SQLite. На Railway обязательно путь внутри Volume: /data/bot.db.
# Рядом с базой бот хранит загруженные документы и готовые КП.
DB_PATH=/data/bot.db

# Умная модель: аудит, КП, тексты, сложные вопросы.
MODEL_SMART=claude-sonnet-5-5

# Быстрая модель: обычный диалог, задачи, поиск, сжатие истории.
MODEL_FAST=claude-haiku-4-5

# ── Необязательные ─────────────────────────────────────────────────────────

# Часовой пояс по умолчанию (потом меняется в /settings).
# DEFAULT_TIMEZONE=Europe/Moscow

# Лимит токенов ответа на один запрос к ИИ (обычный диалог и тексты).
# MAX_TOKENS_PER_REQUEST=4096

# Лимит токенов для больших ответов: отчёт по аудиту и КП.
# MAX_TOKENS_LONG=12000

# Сколько шагов с инструментами агент может сделать за одно сообщение.
# MAX_TOOL_ITERATIONS=8

# Лимиты расходов в долларах США. 0 — без лимита. При превышении бот вежливо откажет.
# DAILY_BUDGET_USD=2
# MONTHLY_BUDGET_USD=30

# Сколько последних сообщений диалога передавать ИИ дословно (старые сжимаются в резюме).
# HISTORY_LIMIT=20

# Порт health-check (Railway задаёт его сам).
# PORT=8080

# Подробность логов: DEBUG, INFO, WARNING.
# LOG_LEVEL=INFO
