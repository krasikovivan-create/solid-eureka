# Скопируйте в .env и заполните. Файл .env не коммитится.

# ===== Telegram =====
# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-your-bot-token
# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789
SHOP_NAME=Fashion Store
# Картинка-баннер приветствия (URL или file_id)
BANNER_URL=https://placehold.co/1200x600/png?text=Fashion+Store
# Ссылка на политику обработки персональных данных (152-ФЗ)
PRIVACY_POLICY_URL=https://example.com/privacy

# ===== Режим запуска =====
# Пусто — long polling (удобно локально). Для продакшена укажите публичный HTTPS-адрес
# сервиса: бот сам поставит вебхук на WEBHOOK_URL + WEBHOOK_PATH. На Render можно не
# заполнять — адрес возьмётся из RENDER_EXTERNAL_URL.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
# Случайная строка: Telegram присылает её в заголовке, чужие запросы отклоняются
WEBHOOK_SECRET=change-me-random-string
HOST=0.0.0.0
PORT=8080

# ===== База данных =====
# Разработка: SQLite. Продакшен: PostgreSQL (postgres://, postgresql:// и
# postgresql+asyncpg:// подходят — драйвер подставится сам)
DATABASE_URL=sqlite+aiosqlite:///./shop.db
# DATABASE_URL=postgresql://shop:shop@localhost:5432/shop
# Хранилище состояний диалогов. Пусто — в памяти (сбрасывается при перезапуске)
REDIS_URL=

# ===== Оплата =====
# fake — тестовая кнопка «Оплатить» без платёжного провайдера (деньги не списываются).
# telegram — счёт через Telegram Payments: токен провайдера из @BotFather → Payments → ЮKassa.
#            Тестовый токен ЮKassa (вида 381764678:TEST:...) работает без договора.
PAYMENTS_MODE=fake
PAYMENT_PROVIDER_TOKEN=
CURRENCY=RUB
# Оплата при получении
COD_ENABLED=true
# Передавать чек 54-ФЗ в ЮKassa (нужно, если касса подключена через ЮKassa)
SEND_RECEIPT=false
# Код ставки НДС для чека ЮKassa: 1 — без НДС
VAT_CODE=1
# Через сколько часов отменять неоплаченные онлайн-заказы
UNPAID_ORDER_TTL_HOURS=24

# ===== Доставка =====
PICKUP_ADDRESS=Москва, ул. Тверская, 1, шоурум (ежедневно 10:00–21:00)
# Mock-трекинг сам переводит посылки «в пути» → «доставлен» (для демо)
MOCK_TRACKING_AUTOADVANCE=false

# ===== Маркетинг =====
ABANDONED_CART_HOURS=24
# Бонус пригласившему после первого заказа друга, ₽
REFERRAL_BONUS=300
# Какую долю заказа можно оплатить бонусами, %
MAX_BONUS_SHARE_PERCENT=30
# Скорость рассылки, сообщений в секунду (лимит Telegram — около 30)
BROADCAST_RATE_PER_SEC=25

# ===== Защита от флуда =====
# Минимальный интервал между действиями пользователя, секунд
THROTTLE_RATE=0.4

# ===== ИИ-стилист (Claude API) =====
STYLIST_ENABLED=true
# Ключ API: https://console.anthropic.com/ → API Keys. Без ключа стилист скрыт.
ANTHROPIC_API_KEY=
# claude-haiku-4-5-20251001 — дёшево и быстро; claude-sonnet-5-5 — качественнее
STYLIST_MODEL=claude-haiku-4-5-20251001
# Запросов к стилисту на пользователя в сутки
STYLIST_DAILY_LIMIT=20
# Таймаут одного запроса к API, секунд, и число автоматических повторов
STYLIST_TIMEOUT=45
STYLIST_MAX_RETRIES=2
STYLIST_MAX_TOKENS=2048
# Сколько последних сообщений диалога помнит стилист
STYLIST_HISTORY_SIZE=10

# ===== Прочее =====
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
